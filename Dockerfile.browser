# syntax=docker/dockerfile:1.7
# Browser-enabled OpenClaw image.
# Built on top of the official ghcr.io/openclaw/openclaw release image.
# Adds Chromium + Xvfb via Playwright (~300 MB extra).
#
# Build manually:
# docker build --build-arg BASE_VERSION=2026.3.15 -f Dockerfile.browser -t openclaw:browser .
ARG BASE_VERSION=latest
FROM ghcr.io/openclaw/openclaw:${BASE_VERSION}

USER root
# Install to /opt/ms-playwright so the browser survives /home/node volume mounts.
# Also create a stable alias path so OpenClaw config does not depend on a versioned chromium-* folder name.
RUN set -e; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb; \
  mkdir -p /opt/ms-playwright; \
  PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
  node /app/node_modules/playwright-core/cli.js install --with-deps chromium; \
  latest_dir="$(find /opt/ms-playwright -maxdepth 1 -mindepth 1 -type d -name 'chromium-*' | sort -V | tail -n 1)"; \
  test -n "$latest_dir"; \
  if [ -x "$latest_dir/chrome-linux64/chrome" ]; then \
    chrome_bin="$latest_dir/chrome-linux64/chrome"; \
  elif [ -x "$latest_dir/chrome-linux/chrome" ]; then \
    chrome_bin="$latest_dir/chrome-linux/chrome"; \
  else \
    echo "Chromium executable not found under $latest_dir" >&2; \
    find "$latest_dir" -maxdepth 3 | sort >&2; \
    exit 1; \
  fi; \
  ln -sfn "$latest_dir" /opt/ms-playwright/chromium-current; \
  ln -sfn "$chrome_bin" /opt/ms-playwright/chromium-current-bin; \
  chown -R node:node /opt/ms-playwright; \
  apt-get clean; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

USER node

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
